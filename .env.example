# Configure through Site runtime settings; never put secret values in source.
OWNER_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

SHIPROCKET_TOKEN=
SHIPROCKET_PICKUP_LOCATION=

# Set to 1 ONLY when this Worker is reachable exclusively through a gateway that
# sets (and strips client-supplied) oai-authenticated-user-* headers. Leave unset
# on a directly reachable Cloudflare Worker, otherwise anyone can impersonate users.
TRUST_PLATFORM_AUTH=

# Free publishing program: how many codes may be redeemed in total (default 100).
FREE_PROGRAM_SLOTS=

# Optional Zoho CRM sync for free-publishing leads (India data centre).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Staff/admin sign-in with Google. Create an OAuth client (Web application) in Google
# Cloud Console and add this redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed in. ADMIN_EMAILS get full admin;
# STAFF_EMAILS get staff access. Removing an email blocks it on its next request.
ADMIN_EMAILS=
STAFF_EMAILS=
