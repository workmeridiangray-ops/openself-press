# Configure through Site runtime settings; never put secret values in source.
OWNER_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

SHIPROCKET_TOKEN=
SHIPROCKET_PICKUP_LOCATION=

# Set to 1 ONLY when this Worker is reachable exclusively through a gateway that
# sets (and strips client-supplied) oai-authenticated-user-* headers. Leave unset
# on a directly reachable Cloudflare Worker, otherwise anyone can impersonate users.
TRUST_PLATFORM_AUTH=

# Free publishing program: how many codes may be redeemed in total (default 100).
FREE_PROGRAM_SLOTS=

# Optional Zoho CRM sync for free-publishing leads (India data centre).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Staff/admin sign-in with Google. Create an OAuth client (Web application) in Google
# Cloud Console and add this redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed in. ADMIN_EMAILS get full admin;
# STAFF_EMAILS get staff access. Removing an email blocks it on its next request.
ADMIN_EMAILS=
STAFF_EMAILS=

# OnlinePrintingz connector. Keep disabled until migration, plugin and test pass.
PRINTING_ENABLED=0
# Same random 32+ character secret as OSP_CONNECTOR_SECRET in WordPress wp-config.php.
PRINTING_SECRET=
# Configure a Worker scheduled trigger every 5 minutes for queue retries/tracking.

# Daily supplier settlements: apply drizzle/0004_printer_settlements.sql first.
SETTLEMENT_SCHEMA=0
FINANCE_MODE=test
# Remain disabled until owner has reviewed setup, test results and beneficiary.
PAYOUTS_ENABLED=0
REFUNDS_ENABLED=0
# HTTPS origin of the separately hosted static-egress relay, without a path.
PROVIDER_RELAY_URL=
# Different from PRINTING_SECRET; same 32+ character value as relay RELAY_SECRET.
PROVIDER_RELAY_SECRET=
# Separate secret for /api/webhooks/razorpayx; configure payout events there.
RAZORPAYX_WEBHOOK_SECRET=
